<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tenno_black"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tv_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/header_title"
        android:textColor="@color/tenno_gold"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.25"
        android:gravity="center"
        android:fontFamily="monospace"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/divider_header"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@color/tenno_gold_dark"
        app:layout_constraintTop_toBottomOf="@id/tv_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <TextView
        android:id="@+id/tv_slot1_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:text="@string/slot1_label"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:gravity="center"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/divider_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline_center" />

    <TextView
        android:id="@+id/tv_slot2_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:text="@string/slot2_label"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:gravity="center"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/divider_header"
        app:layout_constraintStart_toStartOf="@id/guideline_center"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_slot1"
        style="@style/Widget.Tenno.SlotCard"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_slot1_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline_center">

        <TextView
            android:id="@+id/tv_slot1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/slot_empty"
            android:textColor="@color/tenno_gold"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.1" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_slot2"
        style="@style/Widget.Tenno.SlotCard"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_slot2_label"
        app:layout_constraintStart_toStartOf="@id/guideline_center"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_slot2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/slot_empty"
            android:textColor="@color/tenno_gold"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.1" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_result_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/result_label"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.25"
        android:gravity="center"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/card_slot1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_result"
        style="@style/Widget.Tenno.SlotCard"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:strokeColor="@color/tenno_cyan_dark"
        app:layout_constraintTop_toBottomOf="@id/tv_result_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/result_awaiting"
            android:textColor="@color/tenno_cyan"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

    </com.google.android.material.card.MaterialCardView>

    <View
        android:id="@+id/divider_mid"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/tenno_gold_dark"
        app:layout_constraintTop_toBottomOf="@id/card_result"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_grid_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/grid_label"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:gravity="center"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/divider_mid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <GridLayout
        android:id="@+id/grid_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:columnCount="2"
        android:rowCount="3"
        android:useDefaultMargins="false"
        app:layout_constraintTop_toBottomOf="@id/tv_grid_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_heat"
            style="@style/Widget.Tenno.ElementButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:text="@string/btn_heat"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_row="0"
            android:layout_column="0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cold"
            style="@style/Widget.Tenno.ElementButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:text="@string/btn_cold"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_row="0"
            android:layout_column="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toxin"
            style="@style/Widget.Tenno.ElementButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:text="@string/btn_toxin"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_row="1"
            android:layout_column="0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_electricity"
            style="@style/Widget.Tenno.ElementButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:text="@string/btn_electricity"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_row="1"
            android:layout_column="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear"
            style="@style/Widget.Tenno.ClearButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:text="@string/btn_clear"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_row="2"
            android:layout_column="0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_synthesize"
            style="@style/Widget.Tenno.ActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:text="@string/btn_synthesize"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_row="2"
            android:layout_column="1" />

    </GridLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_instructions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:contentDescription="@string/fab_instructions_desc"
        android:src="@android:drawable/ic_menu_info_details"
        app:backgroundTint="@color/tenno_gold"
        app:tint="@color/tenno_black"
        app:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>