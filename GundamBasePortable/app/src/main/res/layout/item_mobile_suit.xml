<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_suit"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Suit image thumbnail (120 × 120 dp) -->
        <ImageView
            android:id="@+id/img_suit_thumbnail"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:scaleType="centerCrop"
            android:contentDescription="Mobile suit image"
            android:src="@drawable/suit_placeholder" />

        <!-- Text column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Model number + faction badge row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_model_number"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorControlNormal"
                    android:letterSpacing="0.08"
                    android:text="RX-78-2" />

                <TextView
                    android:id="@+id/tv_faction_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="EFSF" />

            </LinearLayout>

            <!-- Suit name -->
            <TextView
                android:id="@+id/tv_suit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="@font/orbitron_bold"
                android:text="Gundam" />

            <!-- Pilot -->
            <TextView
                android:id="@+id/tv_pilot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="?attr/colorControlNormal"
                android:text="Pilot: Amuro Ray" />

            <!-- Combat rating label -->
            <TextView
                android:id="@+id/tv_combat_rating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="10sp"
                android:textColor="?attr/colorControlNormal"
                android:text="Combat Rating: 95/100" />

            <!-- Rating progress bar (width set programmatically in adapter) -->
            <View
                android:id="@+id/view_rating_bar"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginTop="3dp"
                android:background="?attr/colorSecondary" />

        </LinearLayout>

        <!-- Arrow indicator -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingEnd="12dp"
            android:text="›"
            android:textSize="24sp"
            android:textColor="?attr/colorControlNormal" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
