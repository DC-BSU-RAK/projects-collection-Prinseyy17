<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_splash.xml
    The window background (set in Theme.GundamBase.Splash via android:windowBackground)
    references @drawable/launch_screen_graphic — drop your custom launch image there.
    This layout is a simple full-screen container to hold the themed window background.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launch_screen_graphic">

    <!-- Optional: app name overlay on top of your graphic -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="60dp"
        android:paddingHorizontal="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/orbitron_bold"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Mobile Suit Combat Database"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</FrameLayout>
