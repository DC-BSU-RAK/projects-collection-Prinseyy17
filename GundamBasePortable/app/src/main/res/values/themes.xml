<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ── Base (shared, no colour) ─────────────────────────────────────── -->
    <style name="Theme.GundamBase.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimStyle</item>
    </style>

    <!-- ── Earth Federation Space Force (EFSF) theme ─────────────────────── -->
    <style name="Theme.GundamBase.EFSF" parent="Theme.GundamBase.Base">
        <item name="colorPrimary">@color/efsf_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/efsf_surface</item>
        <item name="colorSecondary">@color/efsf_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/efsf_background</item>
        <item name="colorOnBackground">@color/efsf_on_surface</item>
        <item name="colorSurface">@color/efsf_surface</item>
        <item name="colorOnSurface">@color/efsf_on_surface</item>
        <item name="colorControlNormal">#AA9BBDDD</item>
        <item name="android:statusBarColor">@color/efsf_status_bar</item>
        <item name="android:navigationBarColor">@color/efsf_background</item>
        <item name="android:windowBackground">@color/efsf_background</item>
    </style>

    <!-- ── Principality of Zeon theme ────────────────────────────────────── -->
    <style name="Theme.GundamBase.Zeon" parent="Theme.GundamBase.Base">
        <item name="colorPrimary">@color/zeon_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/zeon_surface</item>
        <item name="colorSecondary">@color/zeon_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/zeon_background</item>
        <item name="colorOnBackground">@color/zeon_on_surface</item>
        <item name="colorSurface">@color/zeon_surface</item>
        <item name="colorOnSurface">@color/zeon_on_surface</item>
        <item name="colorControlNormal">#AA88AA88</item>
        <item name="android:statusBarColor">@color/zeon_status_bar</item>
        <item name="android:navigationBarColor">@color/zeon_background</item>
        <item name="android:windowBackground">@color/zeon_background</item>
    </style>

    <!-- ── Splash theme ─────────────────────────────────────────────────── -->
    <style name="Theme.GundamBase.Splash" parent="Theme.GundamBase.EFSF">
        <item name="android:windowBackground">@drawable/launch_screen_graphic</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- ── AlertDialog style ────────────────────────────────────────────── -->
    <style name="DialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/efsf_surface</item>
        <item name="colorOnSurface">@color/efsf_on_surface</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- ── Zeon Dialog Theme ────────────────────────────────────────────── -->
    <style name="DialogTheme.Zeon" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/zeon_surface</item>
        <item name="colorOnSurface">@color/zeon_on_surface</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- ── Toolbar title typography ─────────────────────────────────────── -->
    <style name="ToolbarTitleStyle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- ── Window transition animation ─────────────────────────────────── -->
    <style name="WindowAnimStyle" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

</resources>