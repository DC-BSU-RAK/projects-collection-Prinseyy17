<?xml version="1.0" encoding="utf-8"?>
<!--
    detail_image_gradient.xml
    Gradient overlay on the collapsing header image in SuitDetailActivity.
    Bottom-to-top fade from opaque dark to transparent so the image shows above.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#CC000000"
        android:endColor="#00000000" />
</shape>
